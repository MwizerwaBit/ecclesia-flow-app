# Copy to .env.local (git-ignored) to point the app at the real API.
#
#   mock (default) — in-browser demo data, no backend needed
#   rest           — FastAPI backend: real sign-in, httpOnly refresh cookie,
#                    server-side RBAC/ABAC on every request
VITE_API_MODE=rest
VITE_API_URL=http://localhost:8000/api/v1
